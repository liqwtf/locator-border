{
  "schemaVersion": 1,
  "id": "locator-border",
  "version": "${version}",
  "name": "Locator Border",
  "description": "Moves the pesky locator bar to the border of the screen, out of sight!",
  "authors": [
    "liqw"
  ],
  "contact": {
    "sources": "https://github.com/liqwtf/locator-border",
    "issues": "https://github.com/liqwtf/locator-border/issues"
  },
  "license": "MIT",
  "icon": "assets/locator-border/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.liqw.locatorborder.LocatorBorder"
    ],
    "modmenu": [
      "dev.liqw.locatorborder.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "locator-border.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17",
    "minecraft": "${minecraft}"
  }
}